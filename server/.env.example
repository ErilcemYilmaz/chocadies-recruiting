# Vorlage fuer server/.env  -  echte Werte niemals einchecken.
# Kopieren mit:  cp .env.example .env

# Verbindungsstring aus MongoDB Atlas ("Connect" -> "Drivers" -> Node.js).
# Platzhalter <benutzer>, <passwort> und <cluster-url> ersetzen.
MONGODB_URI=mongodb+srv://<benutzer>:<passwort>@<cluster-url>/chocadies-recruiting?retryWrites=true&w=majority

# Port der Server-App (optional, Standard 3000).
PORT=3000

# development | production
NODE_ENV=development
